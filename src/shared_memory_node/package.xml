<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>shared_memory_node</name>
  <version>0.1.0</version>
  <description>Centralized warehouse database node: serves shelf locations, drop-off
  pose, and inventory over ROS 2 services for the grid-aware MRTA system.</description>
  <maintainer email="immemon1811@gmail.com">Mohammad Ibrahim Memon</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>robot_interfaces</depend>
  <depend>mrta_core</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
