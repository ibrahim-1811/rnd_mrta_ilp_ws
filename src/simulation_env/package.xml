<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simulation_env</name>
  <version>0.1.0</version>
  <description>Headless grid-based warehouse simulator: robots move on a shared
  WorldGrid via A*, with live occupancy-driven congestion and a battery model.</description>
  <maintainer email="immemon1811@gmail.com">Mohammad Ibrahim Memon</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>robot_interfaces</depend>
  <depend>mrta_core</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
