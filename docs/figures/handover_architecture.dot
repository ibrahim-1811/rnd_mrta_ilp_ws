digraph architecture {
rankdir=TB;
graph [fontname="DejaVu Sans",fontsize=18,bgcolor="white",pad="0.25",nodesep="0.30",ranksep="0.48",splines=polyline];
node [shape=box,style="rounded,filled",fillcolor="#edf5fc",color="#83aac5",fontcolor="#183044",fontname="DejaVu Sans",fontsize=15,margin="0.18,0.12",penwidth=1.3];
edge [color="#54758c",fontcolor="#3e5d73",fontname="DejaVu Sans",fontsize=11,arrowsize=0.75];

subgraph cluster_ops {label="OPERATIONAL WORKTREE\nrnd_mrta_ilp_ws · traffic/rmf-integration"; color="#9bbad0";style="rounded";fontsize=16;
inputs [label="Inputs
W100.xlsx · warehouse.yaml · orders.csv",fillcolor="#eef8f2",color="#91b6a0"];
gui [label="Dashboard · React / Vite
Operations · History · Experiments"];
api [label="Local API · FastAPI
preview · validate · supervise jobs"];
cli [label="Headless CLI / observed wrapper
run_workload · run_experiment"];
ros [label="ROS 2 entry point
warehouse_sim.launch.py"];
core [label="Shared models and allocation
mrta_core + task_management
directed A* · energy mask · 8 strategies"];
engine [label="Scientific executor and engine
traffic · motion · service · charging
simulation_env",penwidth=2.2,fillcolor="#dcecf8"];
data [label="Scientific artifacts
decisions · outcomes · metrics · run.json",fillcolor="#eef8f2",color="#91b6a0"];
poses [label="Gazebo pose mirror
visualization; no second allocator",fillcolor="#f1f4f7"];
reports [label="Inspection and reports
paired comparisons · graphs · offline HTML"];
{rank=same;gui;ros;}
inputs -> core;
gui -> api -> cli -> core -> engine;
ros -> core;
engine -> data -> reports;
data -> gui [label="read history",constraint=false];
engine -> poses [label="poses"];
engine -> api [label="sampled observation",style=dotted,constraint=false];
}
subgraph cluster_research {label="SEPARATE RESEARCH WORKTREE\nrnd_mrta_ilp_research · research/outcome-aware-ilp";color="#c5b58f";style="rounded";fontsize=16;
m0 [label="M0 · committed
identity · failure kinds · seed purpose"];
m1 [label="M1 · local diagnostics
outcome signals · features · rollouts",fillcolor="#fff7e6",color="#bba879"];
learn [label="M2 onward · planned
predicates → Popper → rules → explanations",style="rounded,dashed,filled",fillcolor="#f5f5f5",color="#9ca8b1"];
m0 -> m1 -> learn;
}
reports -> m0 [style=invis];
m0 -> api [label="GUI compatibility work pending",style=dashed,color="#ac8b4a",constraint=false];
}
