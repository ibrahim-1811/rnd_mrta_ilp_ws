digraph research {
rankdir=TB;
graph [fontname="DejaVu Sans",fontsize=18,bgcolor="white",pad="0.25",nodesep="0.30",ranksep="0.48",splines=polyline];
node [shape=box,style="rounded,filled",fillcolor="#edf5fc",color="#83aac5",fontcolor="#183044",fontname="DejaVu Sans",fontsize=15,margin="0.18,0.12",penwidth=1.3];
edge [color="#54758c",fontcolor="#3e5d73",fontname="DejaVu Sans",fontsize=11,arrowsize=0.75];

subgraph cluster_now {label="AVAILABLE AT DECISION TIME · no future outcome features";style="rounded";color="#9bbad0";
state [label="State S_t
positions · SOC · FIFO window
issued plans and known configuration"];
feat [label="Candidate features
legal route · static time · energy mask
M1 congestion sidecars are diagnostic"];
action [label="Teacher decision D_t
selected eligible pair(s)"];
state -> feat -> action;
}
execution [label="Shared infrastructure executes
traffic waiting and charging emerge later"];
realized [label="Realized outcomes
mission time · waiting · distance · energy",fillcolor="#eef8f2",color="#91b6a0"];
m1 [label="M1 diagnostics · partial
residuals · features · cloned alternatives
current feature-report blocker remains",fillcolor="#fff7e6",color="#bba879"];
m2 [label="M2 · planned data layer
run-scoped IDs · predicates · bias · sampling",style="rounded,dashed,filled",fillcolor="#f5f5f5"];
labels [label="Supervision design
single teacher → multiple teachers
→ outcome-evaluated labels / weights",style="rounded,dashed,filled",fillcolor="#f5f5f5"];
learn [label="M3–M6 · planned Popper learning
learn symbolic allocation rules",style="rounded,dashed,filled",fillcolor="#f5f5f5"];
eval [label="M7–M9 · planned
rule explanations · held-out evaluation · report",style="rounded,dashed,filled",fillcolor="#f5f5f5"];
action -> execution -> realized -> m1;
feat -> m2 [style=dashed,label="future learner inputs"];
m1 -> labels [style=dashed,label="freeze valid supervision"];
m2 -> learn [style=dashed];labels -> learn [style=dashed];learn -> eval [style=dashed];
}
