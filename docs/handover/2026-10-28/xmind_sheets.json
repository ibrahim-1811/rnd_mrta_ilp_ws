    "rootTopic": {
      "id": "4e07408562bedb8b60ce05c1",
      "class": "topic",
      "title": "ILP research and demo commands",
      "children": {
        "attached": [
          {
            "id": "1032746e7e3338a630f96b94",
            "class": "topic",
            "title": "ILP versus MILP",
            "notes": {
              "plain": {
                "content": "Inductive logic programming learns rules. Mixed-integer linear programming optimizes assignments. They are different methods."
              }
            }
          },
          {
            "id": "02925afd44e2946e583a7f64",
            "class": "topic",
            "title": "M0 committed",
            "notes": {
              "plain": {
                "content": "Identity, classified failures, seed controls, deferred decision linkage."
              }
            }
          },
          {
            "id": "6d27ca189b30af4f85eab024",
            "class": "topic",
            "title": "M1 partial diagnostics",
            "notes": {
              "plain": {
                "content": "Residual analysis, decision-time congestion sidecars, cloned alternatives. Current feature reporter has route_cells merge failure. Existing pilot predates fixes."
              }
            }
          },
          {
            "id": "e86574df7434a3b185fb0ee2",
            "class": "topic",
            "title": "M2 planned",
            "notes": {
              "plain": {
                "content": "Run-scoped atoms, learner predicates, bias, sampling, offline teacher relabeling."
              }
            }
          },
          {
            "id": "5132a20379415fe98f3a0700",
            "class": "topic",
            "title": "M3–M6 planned",
            "children": {
              "attached": [
                {
                  "id": "131820139e6bcad722a18075",
                  "class": "topic",
                  "title": "Reproduce Nearest A* with Popper"
                },
                {
                  "id": "eb4714f4ab5f42342e2536ee",
                  "class": "topic",
                  "title": "Single-Teacher ILP"
                },
                {
                  "id": "2ce66f7c2dd4639093fa2df2",
                  "class": "topic",
                  "title": "Multi-Teacher ILP"
                },
                {
                  "id": "27c4c0ac3eba6093ca5183e0",
                  "class": "topic",
                  "title": "Outcome-Aware ILP",
                  "notes": {
                    "plain": {
                      "content": "Freeze objective/labels first; evaluate alternatives; never label unexecuted candidates as observed bad outcomes."
                    }
                  }
                }
              ]
            }
          },
          {
            "id": "e8692ca200b54ddada768e71",
            "class": "topic",
            "title": "M7–M9 planned",
            "notes": {
              "plain": {
                "content": "Rule explanations, held-out policy evaluation, final report; target20December2026."
              }
            }
          },
          {
            "id": "a786dd9eb664a366b2356271",
            "class": "topic",
            "title": "No leakage boundary",
