  {
    "id": "deeb258a21bd089203d6cbd1",
    "class": "sheet",
    "title": "Allocation and execution",
    "rootTopic": {
      "id": "6b86b273ff34fce19d6b804e",
      "class": "topic",
      "title": "Allocation and execution",
      "children": {
        "attached": [
          {
            "id": "18d6e1cac2a8adaf25577cca",
            "class": "topic",
            "title": "Decision trigger",
            "notes": {
              "plain": {
                "content": "Free robots and configured dispatch quantum. q0 continuous; q3 primary research batching."
              }
            }
          },
          {
            "id": "253d950f11ebdbeb4c2d54c5",
            "class": "topic",
            "title": "FIFO candidate window",
            "notes": {
              "plain": {
                "content": "W=fleet_size by default; extend when no eligible pair exists in prefix."
              }
            }
          },
          {
            "id": "d939926f05444b0f4495fb96",
            "class": "topic",
            "title": "Shared candidate features",
            "children": {
              "attached": [
                {
                  "id": "afe33a9e346d92cf11e6465f",
                  "class": "topic",
                  "title": "Directed C_static",
                  "notes": {
                    "plain": {
                      "content": "Exhaustive shelf permutations; legal entry/retreat; distance in metres."
                    }
                  }
                },
                {
                  "id": "fb98ba765d5f99cba6d2c677",
                  "class": "topic",
                  "title": "Estimated finish T",
                  "notes": {
                    "plain": {
                      "content": "C_static/speed + shelf visits*service + dropoff service."
                    }
                  }
                },
                {
                  "id": "51e5cbe75485275b4c971752",
                  "class": "topic",
                  "title": "Hard energy mask",
                  "notes": {
                    "plain": {
                      "content": "Order travel + known service + directed charger leg + 10% reserve <= SOC; no future waiting."
                    }
                  }
                }
              ]
            }
          },
          {
            "id": "0d7f0e336166042f8cc9e4c2",
            "class": "topic",
            "title": "Eight conventional strategies",
            "children": {
              "attached": [
                {
                  "id": "c0e364e71ae53627c7d206f7",
                  "class": "topic",
                  "title": "random",
                  "notes": {
                    "plain": {
                      "content": "Canonical eligible-edge list; seeded shuffle; greedy matching. No uniform matching guarantee."
                    }
                  }
                },
                {
                  "id": "44cddff095c711a0df1baf7f",
                  "class": "topic",
                  "title": "nearest_manhattan",
                  "notes": {
                    "plain": {
                      "content": "Greedy Manhattan shelf-chain ranking; A* route and battery mask still govern execution."
                    }
                  }
                },
                {
                  "id": "0e950ce878b383336b569e75",
                  "class": "topic",
                  "title": "nearest_astar",
                  "notes": {
                    "plain": {
                      "content": "Greedy C_static; ties FIFO then robot_id."
                    }
                  }
                },
                {
                  "id": "989d5ad2e1e94edd9c650ae0",
                  "class": "topic",
                  "title": "earliest_finish",
                  "notes": {
                    "plain": {
                      "content": "Greedy T = C_static / speed + configured shelf/dropoff service. No future waiting."
                    }
                  }
                },
                {
                  "id": "cc72b5d6826e12fc1351c27e",
                  "class": "topic",
                  "title": "multi_criteria",
                  "notes": {
                    "plain": {
                      "content": "0.5 N(T) + 0.2 N(FIFO) + 0.2 N(-energy margin) + 0.1 N(charger distance). Fixed heuristic weights."
                    }
                  }
                },
                {
                  "id": "e8101c9ccb36aab10dc720df",
                  "class": "topic",
                  "title": "auction",
                  "notes": {
                    "plain": {
                      "content": "FIFO sequential single-item auction; cheapest currently-free eligible robot bids C_static."
                    }
                  }
                },
                {
                  "id": "2a60b50547733a6cca803173",
                  "class": "topic",
                  "title": "hungarian",
                  "notes": {
                    "plain": {
                      "content": "Maximum cardinality, then minimum summed C_static; SciPy linear_sum_assignment."
                    }
                  }
                },
                {
                  "id": "6a9864fd1f67758853b832dd",
                  "class": "topic",
                  "title": "milp",
                  "notes": {
                    "plain": {
                      "content": "Maximum cardinality; minimize latest estimated finish, then summed finish; SciPy / HiGHS. Different from inductive logic programming."
                    }
                  }
                }
              ]
            }
          },
          {
            "id": "f70b94aeb67de2a5eb4bd8c2",
            "class": "topic",
            "title": "Capture decision rows",
            "notes": {
              "plain": {
                "content": "One row per scored pair; selected flag; before execution."
              }
            }
          },
          {
            "id": "bd82a28b1f088b3a18673771",
            "class": "topic",
            "title": "Check assignment contract",
            "notes": {
              "plain": {
                "content": "At most one robot per order and one order per robot; only eligible offered pairs."
              }
            }
          },
          {
            "id": "8f854692d8bc8def84a88d51",
            "class": "topic",
            "title": "Execute shared mission",
            "children": {
              "attached": [
                {
                  "id": "4be1f040ecc71e6e889788b3",
                  "class": "topic",
                  "title": "Travel through one-way lanes"
                },
                {
                  "id": "174cbee27d3d31841a9dc591",
                  "class": "topic",
                  "title": "Local traffic / reservations / rotation right-of-way"
                },
                {
                  "id": "92a4aa186ae2b8bb0232a95b",
                  "class": "topic",
                  "title": "Shelf service"
                },
                {
                  "id": "e91c6707dbb2ed7caaea91be",
                  "class": "topic",
                  "title": "Dropoff fulfillment"
                },
                {
                  "id": "bd80e8562b65861ab3a9ac8a",
                  "class": "topic",
                  "title": "Final retreat; robot becomes available"
                }
              ]
            }
          },
          {
            "id": "2da190e578ddcfcde27e7720",
            "class": "topic",
            "title": "Record outcome at retirement",
            "notes": {
              "plain": {
                "content": "Join run_id + original decision_id + robot_id + order_id. M0 fixes deferred-decision linkage."
              }
            }
          },
          {
            "id": "52e90ae24326591c8161e2e0",
            "class": "topic",
            "title": "Recovery and final artifacts",
            "notes": {
              "plain": {
                "content": "Per-robot recovery can overlap other deliveries. Separate order_makespan from fleet settled time."
              }
            }
          }
        ]
      },
      "structureClass": "org.xmind.ui.map.unbalanced"
    }
  },
